# ========================================================
# Dolphin e-Clinic - File Konfigurasi Environment
# ========================================================

# Nama Klinik / Instansi (Dapat diubah bebas tanpa sentuh source code)
NEXT_PUBLIC_CLINIC_NAME="Dolphin e-Clinic"
NEXT_PUBLIC_CLINIC_TAGLINE="Sistem Informasi Manajemen Klinik Terpadu"

# Koneksi Database PostgreSQL
# Jika dijalankan via Docker Compose di host yang sama, port 5432 terbuka di localhost
DATABASE_URL="postgresql://klinik_user:klinik_secret_pass@localhost:5432/dolphin_eclinic?schema=public"

# Kunci Rahasia JWT untuk Session Login (Ganti dengan string acak aman untuk produksi)
JWT_SECRET="dolphin-eclinic-jwt-secret-key-32chars-min-secure-2026"

# Cookie Security (set 'true' jika deploy dengan domain HTTPS / SSL, 'false' untuk LAN HTTP biasa)
COOKIE_SECURE=false

# Port Host yang dipublish ke LAN (default 3002 jika port 3000/3001 sudah terpakai)
APP_PORT=3002
PORT=3000
HOSTNAME="0.0.0.0"

